

  {% if section.blocks.size > 1 %}
    <script
      src="{{ 'announcement-bar.js' | asset_url }}"
      type="module"
      fetchpriority="low"
    ></script>
  {% endif %}

  <div class="section-background color-{{ section.settings.color_scheme }}"></div>
  <aside
    class="announcement-bar spacing-style section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
    style="{% render 'spacing-padding', settings: section.settings %}; --border-bottom-width: {{ section.settings.divider_width }}px;{% if section.settings.infinite_scroll == true %}display: block;{% endif %}"
  >
    {% liquid
      assign autoplay = false
      assign show_arrows = false
      if section.blocks.size > 1
        assign autoplay = true
        assign show_arrows = true
      endif
    %}

    {% if section.settings.infinite_scroll == false %}
      <announcement-bar-component
        class="announcement-bar__slider"
        {% if autoplay == true %}
          autoplay="{{ section.settings.speed }}" aria-live="polite"
        {% endif %}
      >
      {% if show_arrows %}
        {% render 'slideshow-arrows', icon_style: 'chevron' %}
      {% endif %}
      {% assign loop_number = 1 %}
    {% else %}
      <div class="announcement-bar__slider--scroll" data-infinite="{{ section.settings.infinite_scroll }}" style="--infinite-scroll-time: {{ section.settings.speed }}s; --infinite-scroll-gap: {{ section.settings.infinite_scroll_gap }}px; --infinite-scroll-direction: {{ section.settings.infinite_scroll_select }}">
      {% assign loop_number = 8 %}
    {% endif %}
      {% for i in (1..loop_number) %}
        <div class="{% if section.settings.infinite_scroll == false %}announcement-bar__slides{% else %}announcement-bar__block{% endif %}">
          {% content_for 'blocks' %}
        </div>
      {% endfor %}
    {% if section.settings.infinite_scroll == false %}
      </announcement-bar-component>
    {% else %}
    </div>
    {% endif %}
  </aside>

  {% style %}
    .announcement-bar {
      border-block-end: var(--border-bottom-width) solid var(--color-border);
    }

    .announcement-bar__slider {
      display: flex;
      flex-direction: row;
      align-items: center;
      position: relative;

      @media screen and (max-width: 749px) {
        grid-column: 1 / -1;
      }
    }

    .announcement-bar__slides {
      display: grid;
      grid: [stack] auto / [stack] auto;
      width: calc(100% - var(--button-size) * 2);
      max-width: 680px;
      margin-inline: auto;
    }

    .announcement-bar__slides > * {
      grid-area: stack;
    }

    .announcement-bar__slide {
      transition: opacity 0.5s ease-in-out, visibility 0.5s ease-in-out;
      content-visibility: visible;

      &[aria-hidden='true'] {
        opacity: 0;
        visibility: hidden;
      }
    }

    .announcement-bar__slider slideshow-arrows {
      padding: 0;
      mix-blend-mode: normal;
    }

    .announcement-bar__slider slideshow-arrows .slideshow-control {
      color: var(--color-foreground);
    }

    .announcement-bar__slider .slideshow-control {
      display: flex;
      padding: 0;
      width: var(--button-size);
      height: var(--button-size);
      align-items: center;
      justify-content: center;
      opacity: 1;
      animation: none;

      @media screen and (min-width: 750px) {
        --slideshow-control-offset: calc((var(--button-size) - var(--icon-size-xs)) / 2);

        .section--page-width &.slideshow-control--previous {
          transform: translateX(var(--slideshow-control-offset));
        }
      }
    }

    .announcement-bar__slider .slideshow-control .svg-wrapper {
      width: var(--icon-size-xs);
      height: var(--icon-size-xs);
    }

    .announcement-bar__slide {
      place-content: center;
    }

    .announcement-bar__text:first-child {
      margin: 0;
    }

    .announcement-bar__link {
      position: absolute;
      inset: 0;
    }

  {% endstyle %}

  {% schema %}
  {
    "name": "t:names.announcement_bar",
    "blocks": [
      {
        "type": "_announcement"
      }
    ],
    "enabled_on": {
      "groups": ["header"]
    },
    "settings": [
      {
        "type": "checkbox",
        "id": "infinite_scroll",
        "label": "Infinite Loop Scroll",
        "default": false
      },
      {
        "type": "range",
        "id": "infinite_scroll_gap",
        "label": "Gap",
        "step": 2,
        "min": 0,
        "max": 100,
        "unit": "px",
        "default": 40,
        "visible_if": "{{ section.settings.infinite_scroll == true }}"
      },
      {
        "type": "select",
        "id": "infinite_scroll_select",
        "label": "Scroll Direction",
        "options": [
          {
            "value": "scroll-left",
            "label": "Left"
          },
          {
            "value": "scroll-right",
            "label": "Right"
          }
        ],
        "default": "scroll-left",
        "visible_if": "{{ section.settings.infinite_scroll == true }}"
      },
      {
        "type": "range",
        "id": "speed",
        "label": "t:settings.scroll_speed",
        "min": 2,
        "max": 50,
        "default": 5,
        "unit": "sec"
      },
      {
        "type": "header",
        "content": "t:content.appearance"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "t:settings.section_width",
        "options": [
          {
            "value": "page-width",
            "label": "t:options.page"
          },
          {
            "value": "full-width",
            "label": "t:options.full"
          }
        ],
        "default": "page-width"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "default": "scheme-4",
        "label": "t:settings.color_scheme"
      },
      {
        "type": "range",
        "id": "divider_width",
        "label": "t:settings.divider_thickness",
        "min": 0,
        "max": 5,
        "step": 0.5,
        "unit": "px",
        "default": 0
      },
      {
        "type": "header",
        "content": "t:content.padding"
      },
      {
        "type": "range",
        "id": "padding-block-start",
        "label": "t:settings.top",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 15
      },
      {
        "type": "range",
        "id": "padding-block-end",
        "label": "t:settings.bottom",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 15
      }
    ],
    "presets": [
      {
        "name": "t:names.announcement_bar",
        "blocks": {
          "announcement_1": {
            "type": "_announcement"
          }
        },
        "block_order": ["announcement_1"]
      }
    ]
  }
  {% endschema %}

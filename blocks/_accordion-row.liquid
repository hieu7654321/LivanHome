
{% assign block_settings = block.settings %}

{% capture accordion_row_children %}
  <details
    class="details"
    data-testid="accordion-details"
    {% if block_settings.open_by_default %}
      open
    {% endif %}
    {{ block.shopify_attributes }}
  >
    <summary class="details__header" style="
      --font-size: {{ block_settings.font_size }};
      --font-size-desktop: {{ block_settings.font_size_desktop }}px;
      {% if block_settings.line_height == '2p' or block_settings.line_height == '3p' or block_settings.line_height == '4p' %}
      {% case block_settings.line_height %}
        {% when '2p' %}
          --line-height: calc(var( --font-size) + 2px);
        {% when '3p' %}
          --line-height: calc(var( --font-size) + 3px);
        {% else %}
          --line-height: calc(var( --font-size) + 4px);
      {% endcase %}
    {% else %}
      --line-height--display: var(--line-height--display-{{ block_settings.line_height }});
      --line-height--heading: var(--line-height--heading-{{ block_settings.line_height }});
      --line-height--body: var(--line-height--body-{{ block_settings.line_height }});
    {% endif %}
    {% if block_settings.setting_font_desktop %}
      --font-size-desktop: {{ block_settings.font_size_desktop }};
      {% if block_settings.line_height_desktop == 'normal' %}
        --line-height-desktop: 1;
      {% else %}
        {% case block_settings.line_height_desktop %}
          {% when '2p' %}
            --line-height-desktop: calc(var(--font-size-desktop) + 2px);
          {% when '3p' %}
            --line-height-desktop: calc(var(--font-size-desktop) + 3px);
          {% else %}
            --line-height-desktop: calc(var(--font-size-desktop) + 4px);
        {% endcase %}
      {% endif %}
    {% endif %}"
    >
      {% render 'icon-or-image',
        icon: block_settings.icon,
        image_upload: block_settings.image_upload,
        width: block_settings.width,
        class_name: 'details__icon'
      %}
      {{ block_settings.heading }}
      <span class="svg-wrapper icon-caret icon-animated">
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </span>
      <span class="svg-wrapper icon-plus">
        {{- 'icon-plus.svg' | inline_asset_content -}}
      </span>
    </summary>

    <div class="details-content">
      {% content_for 'blocks' %}
    </div>
  </details>
{% endcapture %}
{% if block_settings.heading != empty %}
  {% render 'accordion-custom-component',
    children: accordion_row_children,
    open_by_default_on_desktop: block_settings.open_by_default,
    open_by_default_on_mobile: block_settings.open_by_default
  %}
{% endif %}

{% stylesheet %}
  .details__icon {
    height: auto;
    margin-inline-end: var(--margin-xs);
  }
{% endstylesheet %}

